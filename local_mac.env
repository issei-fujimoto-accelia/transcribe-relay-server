# 外部GPUサーバーの接続設定
# GPUマシンのIPアドレス（またはホスト名）を指定
GPU_SERVER_HOST="localhost"

# 各サービスのURL（ホストが変われば自動追従、個別指定も可能）
WHISPER_API_URL="http://localhost:8080/inference"
OLLAMA_API_URL="http://localhost:11434/api/generate"

# 利用するモデル
TRANSLATION_MODEL="qwen3.5:0.8b"
TRANSLATION_MODEL="qwen3.5:0.8b-mlx"

# ローカル中継サーバーのポート
WSS_PORT=3000
